{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/knopkem/opencode-bench-htj2k/submissions/schema.json",
  "title": "opencode-bench-htj2k submission",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "model",
    "suite_version",
    "score",
    "eligible",
    "decode_speedup",
    "encode_speedup"
  ],
  "properties": {
    "schema": {
      "const": "opencode-bench/htj2k-result@1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string"
    },
    "hardware": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "thinking": {
      "type": "string"
    },
    "reasoning_effort": {
      "type": "string"
    },
    "suite_version": {
      "const": "htj2k-v1"
    },
    "fixture_seed": {
      "type": "integer"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 200
    },
    "eligible": {
      "type": "boolean"
    },
    "integrity_violation": {
      "type": "boolean"
    },
    "gate_ok": {
      "type": "boolean"
    },
    "perf_valid": {
      "type": "boolean"
    },
    "decode_speedup": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "encode_speedup": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "target_decode": {
      "type": "number",
      "minimum": 1
    },
    "target_encode": {
      "type": "number",
      "minimum": 1
    },
    "decode_seed_mp_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "decode_candidate_mp_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "encode_seed_mp_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "encode_candidate_mp_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "gates": {
      "type": "array"
    },
    "wall_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "model_time_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "input_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "output_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reasoning_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "total_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "watchdog": {
      "type": "string"
    },
    "outcome": {
      "type": "string"
    },
    "verified": {
      "type": "boolean"
    },
    "validation_seed": {
      "type": "integer"
    },
    "final_seed": {
      "type": "integer"
    },
    "cpu_set": {
      "type": "string"
    },
    "cpu_count": {
      "type": "integer",
      "minimum": 1
    },
    "network_policy": {
      "type": "string",
      "enum": [
        "open",
        "offline"
      ]
    },
    "rounds_count": {
      "type": "integer",
      "minimum": 1
    },
    "best_round": {
      "type": "integer"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "single-run",
        "multi-run"
      ]
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "agent_error": {
      "type": [
        "object",
        "null"
      ]
    },
    "provider_errors": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provider_error_count": {
      "type": "integer",
      "minimum": 0
    },
    "provider_recovered": {
      "type": "integer",
      "minimum": 0
    },
    "provider_retries": {
      "type": "integer",
      "minimum": 0
    },
    "provider_retry_after_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "gate_pass": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "gate_total": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "steps": {
      "type": [
        "integer",
        "null"
      ]
    },
    "files_changed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "compactions": {
      "type": [
        "integer",
        "null"
      ]
    },
    "span_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "agent_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "ttft_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "think_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "output_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "tool_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "other_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "tool_shell_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "tool_write_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "tool_read_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "tool_other_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "self_test_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "self_test_runs": {
      "type": [
        "integer",
        "null"
      ]
    },
    "self_test_failures": {
      "type": [
        "integer",
        "null"
      ]
    },
    "build_tool_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "wall_ex_self_test_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "self_test_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "retries": {
      "type": [
        "integer",
        "null"
      ]
    },
    "retry_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "step_median_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "step_p90_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "step_max_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "cache_read_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "cache_write_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "compaction_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "max_request_tokens": {
      "type": [
        "integer",
        "null"
      ]
    },
    "mean_request_tokens": {
      "type": [
        "number",
        "null"
      ]
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "cost_known": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "think_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "output_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "tool_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "ttft_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "other_share": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "gen_tokens_per_s": {
      "type": [
        "number",
        "null"
      ]
    },
    "gen_tokens_per_s_median": {
      "type": [
        "number",
        "null"
      ]
    },
    "tokens_per_step": {
      "type": [
        "number",
        "null"
      ]
    },
    "cache_hit_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "metrics_source": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "additionalProperties": true
}
